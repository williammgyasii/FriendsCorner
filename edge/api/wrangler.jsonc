{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "friendscorner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "RoomApi",
      "image": "../../backend/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM_API", "class_name": "RoomApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomApi"] }]
}
